# Environment variables example
# Server-only market data API (e.g., Alpha Vantage, Finnhub, Tiingo, Twelve Data)
MARKET_API_KEY=
MARKET_API_BASE_URL=

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-08
SANITY_API_READ_TOKEN=

# Applications (join page). Tally share link for the application form.
NEXT_PUBLIC_TALLY_FORM_URL=
# ISO 8601 UTC timestamp when applications close (drives the countdown popup)
NEXT_PUBLIC_APPLICATIONS_CLOSE_AT=
